# Required: Google AI Studio Gemini API key
GEMINI_API_KEY=

# Required for internet search; if omitted, regular Gemini answers still work
SERPER_API_KEY=

# Optional; default is a fast and cost-efficient Gemini model
GEMINI_MODEL=gemini-3.5-flash-lite

# Optional: restrict webhook requests to your Yandex skill ID
ALICE_SKILL_ID=

# Optional temporary diagnostics, disabled unless a separate token has >=32 characters.
# Remove this variable after diagnosing. Never use an API key as this token.
DIAGNOSTICS_TOKEN=

# Separate random webhook/signing secret, at least 32 characters
ALICE_ACCESS_TOKEN=

# Use native Node transport with the patched undici dependency
WORKFLOW_NODE_HTTP=1

# Dedicated authenticated Cloudflare Workers AI bridge (optional)
FAST_LLM_URL=
FAST_LLM_TOKEN=
